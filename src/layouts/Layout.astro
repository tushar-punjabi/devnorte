---
import '../styles/global.css';
const { title = 'DevNorte — Comunidad de desarrolladores', description = 'Comparte ideas, crea proyectos y conecta con desarrolladores desde el norte de Chile.' } = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1.0"/><meta name="description" content={description}/><title>{title}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head>
<body>
<header class="topbar"><div class="top-inner"><a class="brand" href="/"><span class="brand-icon">&lt;/&gt;</span> dev<span>norte</span><b>.</b></a><div class="search-wrap"><input id="top-search" type="search" placeholder="Buscar proyectos, preguntas, personas..." aria-label="Buscar publicaciones"/><span>⌕</span></div><nav class="top-actions"><a href="/comunidad" class="top-text">Comunidad</a><a class="btn btn-primary" href="/nuevo">+ Publicar</a></nav></div></header>
<div class="shell"><aside class="sidebar"><div class="nav-caption">EXPLORAR</div><a class:list={['nav-link', {'active':path === '/'}]} href="/"><span>⌂</span> Inicio</a><a class:list={['nav-link',{'active':path.startsWith('/proyectos')}]} href="/proyectos"><span>▦</span> Proyectos</a><a class:list={['nav-link',{'active':path.startsWith('/preguntas')}]} href="/preguntas"><span>?</span> Preguntas</a><a class:list={['nav-link',{'active':path.startsWith('/comunidad')}]} href="/comunidad"><span>♧</span> Comunidad</a><div class="nav-caption separated">CATEGORÍAS</div><a class="nav-link small" href="/?categoria=Proyecto"><i class="dot green"></i> Muestra tu proyecto</a><a class="nav-link small" href="/?categoria=Pregunta"><i class="dot blue"></i> Ayuda y preguntas</a><a class="nav-link small" href="/?categoria=Colaboración"><i class="dot purple"></i> Colaboraciones</a><a class="nav-link small" href="/?categoria=Carrera"><i class="dot orange"></i> Aprendizaje y carrera</a><div class="sidebar-bottom"><p>Una comunidad de personas que construyen tecnología.</p><a href="/reglas">Reglas de la comunidad →</a></div></aside><main class="content"><slot/></main><aside class="rightbar"><div class="panel intro"><div class="intro-head">✳ Comunidad abierta</div><h3>Del norte de Chile, para el mundo.</h3><p>Un espacio para aprender, compartir ideas y construir en comunidad.</p><a class="btn btn-primary full" href="/nuevo">Compartir una idea ↗</a></div><div class="panel"><h4>🌎 Bienvenidos</h4><p class="muted tiny">No importa si estás empezando o si llevas años programando. Aquí todos pueden aportar.</p><hr/><p class="tiny">💻 Aprende construyendo</p><p class="tiny">🤝 Colabora con otros</p><p class="tiny">🚀 Comparte tu proyecto</p></div><div class="legal"><a href="/reglas">Reglas</a> · Prototipo v0.1<br/>Hecho con ♥ desde Chile</div></aside></div>
<nav class="mobile-nav"><a href="/">⌂ <small>Inicio</small></a><a href="/proyectos">▦ <small>Proyectos</small></a><a href="/nuevo">＋ <small>Publicar</small></a><a href="/preguntas">? <small>Preguntas</small></a><a href="/comunidad">♧ <small>Miembros</small></a></nav>
<script is:inline src="/app.js"></script>
</body></html>
