---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Publicación — DevNorte"><div style="margin-bottom:18px"><a class="muted" style="font-size:13px" href="/">← Volver al feed</a></div><div id="post-detail" class="detail"></div><div class="section-heading"><h2>Conversación</h2></div><div class="detail"><div id="comments"></div><form id="comment-form" class="comment-form"><label for="comment-author" style="font-size:12px">Tu alias</label><input id="comment-author" class="comment-input" style="min-height:0;margin-top:8px" required maxlength="40" placeholder="Tu nombre"/><label for="comment-text" style="font-size:12px">Añade un comentario</label><textarea id="comment-text" class="comment-input" style="margin-top:8px" required minlength="2" maxlength="2000" placeholder="Aporta al diálogo con respeto..."></textarea><button class="btn btn-primary" type="submit">Enviar comentario</button><p class="notice">Los comentarios de esta demo se guardan solo en este navegador.</p></form></div></Layout>
